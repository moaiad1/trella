# Copy to .env if you want to override defaults.
#
# --- Default (no .env): SQLite file backend/trella_dev.db — works without Docker/MySQL. ---
# Run uvicorn from the backend/ folder so the DB file is created there.
#
# --- Demo data on first startup ---
# When TRELLA_SEED_DEMO is true (default), the first time the trucks table is empty the API
# inserts a demo seller (seller@trella.demo / demo12345) and 6 sample trucks.
# Set to false for an empty inventory in production:
# TRELLA_SEED_DEMO=false
#
# If tables exist but are empty and seed did not run (e.g. error during startup), run:
#   cd backend && . .venv/bin/activate && python scripts/seed_database.py
#
# --- MySQL in Docker (errno 111 = nothing listening: start the DB first) ---
# From repo root:
#   docker compose up -d
# Then set (example):
# DATABASE_URL=mysql+pymysql://trella:trella@127.0.0.1:3307/trella
#
# --- System MariaDB on 3306 (after creating user; see scripts/setup_mysql_*.sql) ---
# DATABASE_URL=mysql+pymysql://trella:trella@127.0.0.1:3306/trella
#
# --- AI: category suggestion from listing photos (optional) ---
# Without this, the app hides photo-based category hints and does not call OpenAI.
# OPENAI_API_KEY=sk-...
# optional: OPENAI_VISION_MODEL=gpt-4o-mini
